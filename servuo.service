[Unit]
Description=ServUO Ultima Online Emulator Service
After=network.target

[Service]
Type=forking
User=servuo
Group=servuo
WorkingDirectory=/home/servuo/ServUO
# Явно указываем использование mono и проверяем путь
ExecStart=/usr/bin/screen -dmS servuo /usr/bin/mono /home/servuo/ServUO/ServUO.exe -release

ExecStop=/usr/bin/screen -S servuo -X eval "stuff '[save\015'"
ExecStop=/bin/sleep 5
ExecStop=/usr/bin/screen -S servuo -X eval "stuff '[shutdown\015'"
ExecStop=/bin/sleep 5

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

## for controll from console type `screen -r servuo`
